{
    "name": "@elurjs/core-compiler",
    "version": "1.0.0",
    "description": "Build-time compiler for Elur html`` templates — pre-computes descriptors, pathMaps, and generates direct node access code.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "elur",
        "compiler",
        "template",
        "dom",
        "reactive",
        "signals",
        "vite"
    ],
    "author": "elurjs",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/elurjs/core-compiler.git"
    },
    "homepage": "https://github.com/elurjs/core-compiler#readme",
    "bugs": {
        "url": "https://github.com/elurjs/core-compiler/issues"
    },
    "devDependencies": {
        "typescript": "^7.0.0",
        "vitest": "^4.1.11"
    }
}